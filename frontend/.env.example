# Application Configuration
VITE_APP_NAME=Relay
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# WebSocket Configuration
VITE_SOCKET_URL=http://localhost:3000
VITE_SOCKET_PATH=/socket.io

# Authentication
VITE_AUTH_TOKEN_KEY=relay_auth_token
VITE_AUTH_REFRESH_TOKEN_KEY=relay_refresh_token
VITE_AUTH_USER_KEY=relay_user

# Feature Flags
VITE_FEATURE_LIVE_SESSIONS=true
VITE_FEATURE_SLACK_INTEGRATION=true
VITE_FEATURE_DARK_MODE=false
VITE_FEATURE_ANALYTICS=false

# Video Recording Configuration
VITE_MAX_RECORDING_SIZE_MB=500
VITE_MAX_RECORDING_DURATION_MINUTES=60
VITE_RECORDING_COUNTDOWN_SECONDS=3
VITE_PREFERRED_VIDEO_CODEC=vp9
VITE_VIDEO_BITRATE=2500000

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_SIDEBAR_COLLAPSED=false
VITE_ITEMS_PER_PAGE=20

# Monitoring & Analytics (optional)
VITE_SENTRY_DSN=
VITE_GA_TRACKING_ID=
VITE_MIXPANEL_TOKEN=

# Upload Configuration
VITE_CHUNK_SIZE=5242880  # 5MB in bytes
VITE_MAX_PARALLEL_UPLOADS=3
VITE_UPLOAD_RETRY_ATTEMPTS=3

# Notification Settings
VITE_TOAST_DURATION=4000
VITE_NOTIFICATION_SOUND=true

# Debug Settings
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=warn