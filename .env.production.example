# CogVeri Production Environment Configuration
# Copy this file to .env.production and fill in with your actual values

# ============================================================
# Application Configuration
# ============================================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================================
# Frontend Configuration (Vercel)
# ============================================================
VITE_API_URL=https://api.cogveri.com
VITE_SOCKET_URL=https://api.cogveri.com
VITE_APP_NAME=CogVeri
VITE_AUTH_TOKEN_KEY=cogveri_auth_token
VITE_AUTH_REFRESH_TOKEN_KEY=cogveri_refresh_token

# ============================================================
# Database Configuration
# ============================================================
# PostgreSQL connection string for production
DATABASE_URL=postgresql://cogveri_user:YOUR_DB_PASSWORD@your-db-host:5432/cogveri_prod
DB_NAME=cogveri_prod
DB_USER=cogveri_user
DB_PASSWORD=YOUR_DB_PASSWORD
DB_HOST=your-db-host
DB_PORT=5432
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================
# Authentication & Security
# ============================================================
# CRITICAL: Both JWT secrets are REQUIRED - app will not start without them
# Generate with: openssl rand -base64 64
JWT_SECRET=YOUR_VERY_LONG_AND_SECURE_JWT_SECRET_KEY_HERE
JWT_REFRESH_SECRET=YOUR_DIFFERENT_REFRESH_TOKEN_SECRET_KEY_HERE
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# REQUIRED: CSRF protection secret — must differ from JWT_SECRET
# Generate with: openssl rand -base64 64
CSRF_SECRET=YOUR_CSRF_SECRET_KEY_HERE
CORS_ORIGIN=https://cogveri.com,https://www.cogveri.com
FRONTEND_URL=https://cogveri.com

# ============================================================
# Redis Configuration (for caching and sessions)
# ============================================================
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DB=0

# ============================================================
# Cloudflare R2 Configuration (S3-compatible storage)
# ============================================================
AWS_REGION=auto
AWS_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
AWS_S3_BUCKET=cogveri-production
AWS_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ============================================================
# Per-Organization Bucket Configuration (Enterprise Data Isolation)
# ============================================================
# Cloudflare API credentials for bucket provisioning
# Required for automatic per-org bucket creation
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# Bucket naming prefix (buckets will be named: {prefix}-{orgIdShort})
# Example: cogveri-prod-a1b2c3d4
BUCKET_NAME_PREFIX=cogveri-prod

# ============================================================
# Email Configuration (SendGrid, AWS SES, or other)
# ============================================================
EMAIL_ENABLED=true
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=YOUR_SENDGRID_API_KEY
EMAIL_FROM=noreply@cogveri.com
EMAIL_FROM_NAME=CogVeri

# ============================================================
# DNS & Domain Configuration
# ============================================================
DOMAIN=cogveri.com
API_URL=https://api.cogveri.com
SOCKET_URL=https://api.cogveri.com
DNS_PROVIDER=cloudflare
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# ============================================================
# SSO Configuration (Optional - for SAML/OAuth)
# ============================================================
SSO_ENABLED=false
SSO_ENTRY_POINT=https://your-sso-provider.com/sso
SSO_ISSUER=cogveri-app
SSO_CALLBACK_URL=https://cogveri.com/api/auth/callback
SSO_CERT_PATH=/etc/cogveri/sso-cert.pem

# ============================================================
# Storage & Resource Limits
# ============================================================
STORAGE_QUOTA_GB=10
STORAGE_QUOTA_RECORDINGS_GB=50
API_RATE_LIMIT=100
API_RATE_WINDOW_MINUTES=15
MAX_UPLOAD_SIZE_MB=500

# ============================================================
# Monitoring & Analytics (Optional)
# ============================================================
SENTRY_DSN=
DATADOG_API_KEY=
SLACK_WEBHOOK_URL=

# ============================================================
# Feature Flags
# ============================================================
FEATURE_SSO_ENABLED=false
FEATURE_MULTI_TENANT=true
FEATURE_CUSTOM_DOMAIN=true
FEATURE_RECORDING_RETENTION=true
FEATURE_API_METRICS=true

# ============================================================
# Production Reset Script (run-reset-prod.js)
# These are only needed if running a full database reset
# ============================================================
SUPER_ADMIN_EMAIL=admin@cogveri.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
# Optional secondary admin:
SECONDARY_ADMIN_EMAIL=
SECONDARY_ADMIN_PASSWORD=
SECONDARY_ADMIN_NAME=

# ============================================================
# Deployment Notes
# ============================================================
# Backend is deployed on AWS EC2. There is no Coolify token needed.
# Ensure the EC2 security group restricts inbound to Cloudflare IPs only.
# Cloudflare Tunnel handles SSL termination and routing to the EC2 instance.
