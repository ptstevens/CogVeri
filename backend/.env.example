# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cogveri_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cogveri_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# CSRF Protection
# REQUIRED in production. Generate with: openssl rand -base64 64
# Must be different from JWT_SECRET (secret separation)
CSRF_SECRET=

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=cogveri-recordings
S3_ENDPOINT=http://localhost:9000  # For MinIO local development

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# SSO Configuration (SAML) - Legacy
SSO_ENABLED=false
SSO_ENTRY_POINT=https://your-idp.com/sso/saml
SSO_ISSUER=cogveri-app
SSO_CALLBACK_URL=http://localhost:3000/api/auth/saml/callback
SSO_CERT=your-saml-certificate
SSO_PRIVATE_KEY=your-private-key

# Slack Integration
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Redis Configuration (optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Email Configuration (Gmail SMTP - Free Option)
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM="CogVeri <noreply@cogveri.com>"
# To get Gmail App Password:
# 1. Go to Google Account settings
# 2. Security > 2-Step Verification (must be enabled)
# 3. App passwords > Generate new app password
# 4. Copy the 16-character password to EMAIL_PASSWORD

# Video Recording Settings
MAX_RECORDING_SIZE_MB=500
MAX_RECORDING_DURATION_MINUTES=60
ALLOWED_VIDEO_FORMATS=webm,mp4

# Session Configuration
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=86400000  # 24 hours in milliseconds

# Application URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Feature Flags
FEATURE_LIVE_SESSIONS=true
FEATURE_SLACK_NOTIFICATIONS=true
FEATURE_EMAIL_NOTIFICATIONS=false

# Database Setup / Production Reset (run-reset-prod.js)
# All credentials are env-var driven - never hardcode these
SUPER_ADMIN_EMAIL=admin@cogveri.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=System Administrator
# Optional: secondary admin created during reset (if both are set)
SECONDARY_ADMIN_EMAIL=
SECONDARY_ADMIN_PASSWORD=
SECONDARY_ADMIN_NAME=
